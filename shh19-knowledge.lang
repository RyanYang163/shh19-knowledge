[zh-cn]
name = "知识库阅读器"
auth = "shh"
descript = "把 TNAS 上已有的文件夹注册成只读的知识空间。把目录加入白名单后，应用扫描一次目录树，把文件元数据与文本内容写入本地 SQLite 索引，之后浏览与搜索都不再重复扫盘。内置查看器直接阅读 PDF、图片、Markdown、HTML、纯文本与源码、JSON、XML、YAML、CSV、Word、Excel、PowerPoint 以及音视频；其中 Office 文档与 PDF 的文字层由应用自身解析，不需要任何外部程序，PDF 由随包分发的阅读器渲染，支持页码跳转与文档内搜索。全文检索基于 SQLite FTS5，可按文件类型、路径与时间过滤，按相关度排序，命中处高亮并给出所在页码或工作表。另有收藏、最近阅读、相关文件、快速打开与自定义文件图标；目录树、阅读区与信息栏均可拖动调整，支持浅色、深色与跟随系统。应用对源文件严格只读——不修改、不删除、不移动、不改名任何文件。全部功能离线可用。"
release_note = "1. 首次发布。"
important = "严格只读。知识库里的任何文件都不会被修改、删除、移动或重命名。索引与阅读全部在本机完成，应用不发起任何对外网络请求。"

[zh-hk]
name = "知識庫閱讀器"
auth = "shh"
descript = "把 TNAS 上已有的資料夾註冊成唯讀的知識空間。把目錄加入白名單後，應用掃描一次目錄樹，把檔案中繼資料與文字內容寫入本機 SQLite 索引，之後瀏覽與搜尋都不再重複掃碟。內建檢視器直接閱讀 PDF、圖片、Markdown、HTML、純文字與原始碼、JSON、XML、YAML、CSV、Word、Excel、PowerPoint 以及音訊影片；其中 Office 文件與 PDF 的文字層由應用自身解析，不需要任何外部程式，PDF 由隨包分發的閱讀器渲染，支援頁碼跳轉與文件內搜尋。全文檢索基於 SQLite FTS5，可依檔案類型、路徑與時間過濾，依相關度排序，命中處高亮並給出所在頁碼或工作表。另有收藏、最近閱讀、相關檔案、快速開啟與自訂檔案圖示；目錄樹、閱讀區與資訊欄均可拖動調整，支援淺色、深色與跟隨系統。應用對來源檔案嚴格唯讀——不修改、不刪除、不移動、不重新命名任何檔案。全部功能離線可用。"
release_note = "1. 首次發佈。"
important = "嚴格唯讀。知識庫裡的任何檔案都不會被修改、刪除、移動或重新命名。索引與閱讀全部在本機完成，應用不發起任何對外網路請求。"

[en-us]
name = "Knowledge Base"
auth = "shh"
descript = "Turns folders on your TNAS into read-only knowledge spaces. A whitelisted folder is indexed once, so browsing and search never re-walk the disk. Viewers cover PDF, images, Markdown, HTML, text, code, CSV, audio and video. Word, Excel, PowerPoint and the PDF text layer are parsed inside the app, with no external program. Full-text search runs on SQLite FTS5 with type, path and time filters and highlighted hits. Also favourites, recently read and quick open. Strictly read-only and fully offline."
release_note = "1. Initial release."
important = "Strictly read-only. No file in your knowledge base is ever modified, deleted, moved or renamed. All indexing and reading happens locally; the application makes no outbound network request."

[fr-fr]
name = "Lecteur de base de connaissances"
auth = "shh"
descript = "Vos dossiers TNAS deviennent des espaces de connaissance en lecture seule. Après autorisation, elle scanne l'arborescence une fois et indexe métadonnées et texte dans un SQLite local : ensuite, plus de rescan. Le lecteur intégré ouvre PDF, images, Markdown, HTML, texte, JSON, CSV, Office et médias ; les documents Office et le texte des PDF sont analysés par l'application elle-même, sans programme externe. La recherche plein texte (SQLite FTS5) filtre par type, chemin et date et trie par pertinence."
release_note = "1. Première version."
important = "Strictement en lecture seule : aucun fichier n'est modifié, supprimé, déplacé ou renommé. Indexation et lecture se font entièrement en local, l'application n'émet aucune requête réseau."

[de-de]
name = "Wissensdatenbank-Leser"
auth = "shh"
descript = "Ihre TNAS-Ordner werden zu schreibgeschützten Wissensräumen. Nach der Freigabe durchsucht die App den Baum einmal und indexiert Metadaten und Text in einem lokalen SQLite: danach kein erneutes Scannen. Der eingebaute Betrachter öffnet PDF, Bilder, Markdown, HTML, Text, JSON, CSV, Office und Medien; Office-Dokumente und die Textebene von PDF liest die App selbst, ohne externe Programme. Die Volltextsuche (SQLite FTS5) filtert nach Typ, Pfad und Datum und sortiert nach Relevanz."
release_note = "1. Erstveröffentlichung."
important = "Strikt schreibgeschützt: keine Datei wird geändert, gelöscht, verschoben oder umbenannt. Indexierung und Lesen laufen vollständig lokal, die App stellt keine Netzwerkanfragen."

[it-it]
name = "Lettore di knowledge base"
auth = "shh"
descript = "Le tue cartelle TNAS diventano spazi di conoscenza in sola lettura. Dopo l'autorizzazione l'app scansiona l'albero una volta e indicizza metadati e testo in un SQLite locale: poi niente più scansioni. Il lettore integrato apre PDF, immagini, Markdown, HTML, testo, JSON, CSV, Office e media; i documenti Office e il livello di testo dei PDF li analizza l'app stessa, senza programmi esterni. La ricerca full-text (SQLite FTS5) filtra per tipo, percorso e data e ordina per pertinenza."
release_note = "1. Prima versione."
important = "Rigorosamente in sola lettura: nessun file viene modificato, eliminato, spostato o rinominato. Indicizzazione e lettura avvengono interamente in locale e l'app non effettua richieste di rete."

[es-es]
name = "Lector de base de conocimiento"
auth = "shh"
descript = "Tus carpetas del TNAS pasan a ser espacios de conocimiento de solo lectura. Tras autorizarlas, la aplicación recorre el árbol una vez e indexa metadatos y texto en un SQLite local: después ya no escanea. El visor integrado abre PDF, imágenes, Markdown, HTML, texto, JSON, CSV, Office y medios; los documentos de Office y la capa de texto de los PDF los analiza la propia aplicación, sin programas externos. La búsqueda de texto completo (SQLite FTS5) filtra por tipo, ruta y fecha y ordena por relevancia."
release_note = "1. Primera versión."
important = "Estrictamente de solo lectura: ningún archivo se modifica, elimina, mueve ni renombra. La indexación y la lectura son totalmente locales y la aplicación no realiza peticiones de red."

[hu-hu]
name = "Tudásbázis-olvasó"
auth = "shh"
descript = "A TNAS-mappák csak olvasható tudásterekké válnak. Engedélyezés után az alkalmazás egyszer bejárja a fát, és metaadatokat meg szöveget indexel egy helyi SQLite-ba: utána nincs többé újraszkennelés. A beépített néző megnyit PDF, képet, Markdown, HTML, szöveg, JSON, CSV, Office és médiafájlokat; az Office-dokumentumokat és a PDF szövegrétegét maga az alkalmazás dolgozza fel, külső program nélkül. A teljes szöveges keresés (SQLite FTS5) típus, útvonal és dátum szerint szűr, relevancia szerint rendez."
release_note = "1. Első kiadás."
important = "Szigorúan csak olvasás: egyetlen fájl sem módosul, törlődik, mozog vagy neveződik át. Az indexelés és az olvasás teljesen helyben történik, az alkalmazás nem indít hálózati kérést."

[ja-jp]
name = "ナレッジベースリーダー"
auth = "shh"
descript = "TNAS のフォルダーが読み取り専用の知識スペースになります。許可するとアプリはツリーを一度だけ走査し、メタデータとテキストをローカルの SQLite に索引化します。以後の閲覧と検索で再走査は起きません。内蔵ビューアーは PDF、画像、Markdown、HTML、テキスト、JSON、CSV、Office、メディアを開き、Office 文書と PDF のテキスト層はアプリ自身が解析するため外部プログラムは不要です。全文検索（SQLite FTS5）は種類・パス・日付で絞り込み、関連度で並べ替えます。"
release_note = "1. 初回リリース。"
important = "厳密に読み取り専用です。ファイルの変更・削除・移動・名前変更は一切行いません。索引作成と閲覧はすべて本機で完結し、外部への通信は発生しません。"

[ko-kr]
name = "지식 베이스 리더"
auth = "shh"
descript = "TNAS 폴더가 읽기 전용 지식 공간이 됩니다. 허용하면 앱이 트리를 한 번만 훑어 메타데이터와 텍스트를 로컬 SQLite에 색인합니다. 이후 탐색과 검색은 다시 스캔하지 않습니다. 내장 뷰어는 PDF, 이미지, Markdown, HTML, 텍스트, JSON, CSV, Office, 미디어를 열고, Office 문서와 PDF 텍스트 레이어는 앱이 직접 분석하므로 외부 프로그램이 필요 없습니다. 전문 검색(SQLite FTS5)은 종류·경로·날짜로 걸러 관련도순으로 정렬합니다."
release_note = "1. 최초 릴리스."
important = "엄격히 읽기 전용입니다. 파일을 수정·삭제·이동·이름 변경하지 않습니다. 색인과 열람은 모두 본체에서 이뤄지며 외부 통신을 하지 않습니다."

[pl-pl]
name = "Czytnik bazy wiedzy"
auth = "shh"
descript = "Twoje foldery na TNAS stają się przestrzeniami wiedzy tylko do odczytu. Po zatwierdzeniu aplikacja przechodzi drzewo raz i indeksuje metadane oraz tekst w lokalnym SQLite: potem koniec z ponownym skanowaniem. Wbudowana przeglądarka otwiera PDF, obrazy, Markdown, HTML, tekst, JSON, CSV, Office i multimedia; dokumenty Office i warstwę tekstową PDF analizuje sama aplikacja, bez zewnętrznych programów. Wyszukiwanie pełnotekstowe (SQLite FTS5) filtruje po typie, ścieżce i dacie oraz sortuje po trafności."
release_note = "1. Pierwsze wydanie."
important = "Ściśle tylko odczyt: żaden plik nie jest zmieniany, usuwany, przenoszony ani przemianowywany. Indeksowanie i czytanie odbywają się w całości lokalnie, aplikacja nie wykonuje żądań sieciowych."

[ru-ru]
name = "Читалка базы знаний"
auth = "shh"
descript = "Папки на TNAS становятся пространствами знаний только для чтения. После разрешения приложение один раз обходит дерево и индексирует метаданные и текст в локальный SQLite: дальше повторных сканирований нет. Встроенная читалка открывает PDF, изображения, Markdown, HTML, текст, JSON, CSV, Office и медиа; документы Office и текстовый слой PDF разбирает само приложение, без внешних программ. Полнотекстовый поиск (SQLite FTS5) фильтрует по типу, пути и дате и сортирует по релевантности."
release_note = "1. Первый выпуск."
important = "Строго только чтение: ни один файл не изменяется, не удаляется, не перемещается и не переименовывается. Индексация и чтение выполняются полностью локально, приложение не делает сетевых запросов."

[tr-tr]
name = "Bilgi tabanı okuyucu"
auth = "shh"
descript = "TNAS klasörleriniz salt okunur bilgi alanlarına dönüşür. İzin verdikten sonra uygulama ağacı bir kez tarar ve üst verileri ve metni yerel SQLite'a dizinler: sonrasında yeniden tarama yok. Yerleşik görüntüleyici PDF, görsel, Markdown, HTML, metin, JSON, CSV, Office ve medyayı açar; Office belgelerini ve PDF metin katmanını uygulamanın kendisi çözümler, harici program gerekmez. Tam metin arama (SQLite FTS5) tür, yol ve tarihe göre süzer ve ilgililiğe göre sıralar."
release_note = "1. İlk sürüm."
important = "Kesinlikle salt okunur: hiçbir dosya değiştirilmez, silinmez, taşınmaz veya yeniden adlandırılmaz. Dizinleme ve okuma tamamen yerelde yapılır, uygulama ağ isteği göndermez."

[pt-pt]
name = "Leitor de base de conhecimento"
auth = "shh"
descript = "As suas pastas do TNAS tornam-se espaços de conhecimento só de leitura. Após autorizar, a aplicação percorre a árvore uma vez e indexa metadados e texto num SQLite local: depois, sem novas varreduras. O visualizador integrado abre PDF, imagens, Markdown, HTML, texto, JSON, CSV, Office e multimédia; os documentos Office e a camada de texto dos PDF são analisados pela própria aplicação, sem programas externos. A pesquisa de texto integral (SQLite FTS5) filtra por tipo, caminho e data e ordena por relevância."
release_note = "1. Primeira edição."
important = "Estritamente só de leitura: nenhum ficheiro é modificado, eliminado, movido ou renomeado. A indexação e a leitura são totalmente locais e a aplicação não faz pedidos de rede."
